# --------------------------------------------------------
# Indian Pixel OS — Production Environment Configuration
# --------------------------------------------------------

# 1. Database Connection (PostgreSQL on Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# 2. Application Host
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Cryptography & Session Secrets
SESSION_SECRET="your-256-bit-random-secret-key-here"

# 4. Payment Gateways & Webhooks
PAYMENT_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
STRIPE_SECRET_KEY="sk_live_your_stripe_key"

# 5. Email Dispatcher (Resend / SMTP)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Indian Pixel Studio <noreply@indianpixel.com>"

# 6. Object Storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET_NAME="indian-pixel-assets"
STORAGE_ACCESS_KEY_ID="your_storage_access_key"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_key"
